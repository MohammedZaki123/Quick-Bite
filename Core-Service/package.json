  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "build": "tsc",
    "dev": "tsx watch src/server",
    "worker:dev": "tsx watch src/worker",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "knex --knexfile src/lib/knex/knexfile.ts migrate:latest",
    "migrate:all": "tsx scripts/migrate-all.ts",
    "migrate:rollback": "knex --knexfile src/lib/knex/knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile src/lib/knex/knexfile.ts migrate:status",
    "migrate:make": "knex --knexfile src/lib/knex/knexfile.ts migrate:make",
    "seed:rbac": "knex --knexfile src/lib/knex/knexfile.ts migrate:run --specific=20260403234043_seed_rbac_tables.ts"
  },
  "dependencies": {
    "@types/amqplib": "^0.10.8",
